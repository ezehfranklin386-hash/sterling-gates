{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "vercel-nextjs",
      "config": {
        "includePackages": true
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
